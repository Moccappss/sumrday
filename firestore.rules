rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public readable CMS data (Landing page, Blog, Portfolio, Custom Pages)
    // Only authenticated users can write/modify CMS settings
    match /cms/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Users Collection: User can read and update their own document, admin can manage
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) || isAuthenticated();
    }

    // Activity Logs: Authenticated users can write log entries, only authenticated can read
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit trail
    }

    // Public Contact Messages / Inbox: Anyone can create a message (contact form submission)
    match /contact_inbox/{msgId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'message'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAuthenticated();
    }

    // Live Chat Messages: Validated creation, admin can update/delete
    match /live_chat/{chatId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['text', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000;
      allow update, delete: if isAuthenticated();
    }

    // Default deny for anything not explicitly matched
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
