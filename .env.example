# ╔══════════════════════════════════════════════════════════════════════════════════╗
# ║                  PANDUAN LENGKAP PENGISIAN ENVIRONMENT VARIABLES                 ║
# ║                            AGENZE CMS & PORTFOLIO                               ║
# ╠══════════════════════════════════════════════════════════════════════════════════╣
# ║  File ini adalah template untuk menyiapkan website/klien baru (Tempat ke-2).    ║
# ║                                                                                  ║
# ║  CARA MENGGUNAKAN:                                                               ║
# ║  1. Duplikat file ini dan beri nama: .env                                        ║
# ║     (Atau beri nama .env.site2 jika menggunakan multi-mode build)                 ║
# ║  2. Ikuti tutorial di setiap bagian di bawah untuk mengambil token & kuncinya.   ║
# ║  3. Setelah terisi semua, jalankan: npm run dev                                  ║
# ║  4. Buka menu Admin -> "Cloud & Sync" untuk memastikan semua indikator HIJAU.    ║
# ╚══════════════════════════════════════════════════════════════════════════════════╝

# ==================================================================================
# 1. 🔥 FIREBASE (DATABASE UTAMA / FIRESTORE)
# ==================================================================================
# Fungsi: Menyimpan artikel blog, portofolio, pesan kontak, audit log, dan pengaturan.
# 
# 📌 CARA MENDAPATKAN KODE FIREBASE:
# 1. Buka https://console.firebase.google.com/ lalu login akun Google Anda.
# 2. Klik "Add project" (Tambah project) -> Beri nama project baru (contoh: "agenze-klien2").
# 3. Nonaktifkan Google Analytics (opsional agar cepat) -> Klik "Create project".
# 4. Setelah selesai, di halaman Overview, klik ikon Web (ikon "</>").
# 5. Beri nama App Nickname -> Centang "Also set up Firebase Hosting" -> Klik "Register app".
# 6. Salin objek `firebaseConfig` yang muncul. Masukkan nilainya ke masing-masing baris di bawah:
# 
# ⚠️ PENTING: Jangan lupa aktifkan Firestore Database!
#    Di menu kiri Firebase Console -> Build -> Firestore Database -> Create Database ->
#    Pilih lokasi (misal: asia-southeast2 / Jakarta) -> Pilih "Start in test mode" -> Done.
# ==================================================================================
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=nama-project-anda.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nama-project-anda
VITE_FIREBASE_STORAGE_BUCKET=nama-project-anda.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ==================================================================================
# 2. ☁️ CLOUDINARY (PENYIMPANAN GAMBAR & MEDIA)
# ==================================================================================
# Fungsi: Menyimpan gambar portofolio, logo, avatar, dan banner secara gratis & cepat.
# 
# 📌 CARA MENDAPATKAN CLOUD NAME & UPLOAD PRESET:
# 1. Buka https://cloudinary.com/ lalu daftar akun baru (atau login akun lama).
# 2. Buka "Dashboard":
#    -> Di bagian "Product Environment Credentials", temukan "Cloud Name".
#    -> Salin nama Cloud Name tersebut ke VITE_CLOUDINARY_NAME di bawah.
#
# 3. Membuat Upload Preset (Wajib agar upload gambar dari web berhasil):
#    -> Klik ikon Gerigi / Settings (di kiri bawah dashboard Cloudinary).
#    -> Pilih tab "Upload" -> Scroll ke bawah ke bagian "Upload presets".
#    -> Klik "Add upload preset".
#    -> Beri nama preset (misal: ml_default atau agenze_preset).
#    -> Pada "Signing Mode", UBAH dari Signed menjadi "Unsigned" (SANGAT PENTING!).
#    -> Klik tombol "Save" (Simpan).
#    -> Masukkan nama preset tersebut ke VITE_CLOUDINARY_PRESET di bawah.
# ==================================================================================
VITE_CLOUDINARY_NAME=nama_cloud_anda
VITE_CLOUDINARY_PRESET=ml_default


# ==================================================================================
# 3. 📊 GOOGLE SERVICES (SPREADSHEET & APPS SCRIPT)
# ==================================================================================
# Fungsi: Backup otomatis data form, sinkronisasi kontak masuk, dan manajemen spreadsheet.
# 
# 📌 CARA MENDAPATKAN GOOGLE SHEET ID:
# 1. Buka https://docs.google.com/spreadsheets/ dan buat Spreadsheet baru (atau copy yang lama).
# 2. Lihat URL di browser:
#    https://docs.google.com/spreadsheets/d/11CteMG8hM_W0Eh6cvXF9sHJ-bbsu0NhnWSfR3OtAhaw/edit
#    Kode di antara "/d/" dan "/edit" adalah SHEET_ID Anda.
#    (Contoh pada URL di atas: 11CteMG8hM_W0Eh6cvXF9sHJ-bbsu0NhnWSfR3OtAhaw)
# 
# 📌 CARA MEMBUAT APPS SCRIPT WEB APP:
# 1. Di Google Sheets Anda, klik menu "Extensions" (Ekstensi) -> "Apps Script".
# 2. Hapus kode default `myFunction()`.
# 3. Buka file `google_apps_script.js` yang ada di folder project ini, copy SEMUA isinya,
#    lalu paste ke editor Apps Script tersebut.
# 4. Klik ikon Save (Disket).
# 5. Klik tombol biru "Deploy" (Terapkan) di kanan atas -> "New deployment" (Penerapan baru).
# 6. Klik ikon Gerigi di sebelah "Select type" -> Pilih "Web app".
# 7. Isi:
#    - Description: Agenze API
#    - Execute as: "Me" (email Anda)
#    - Who has access: "Anyone" (Siapa saja — WAJIB agar web bisa kirim data).
# 8. Klik "Deploy" -> Berikan izin akun Google jika diminta.
# 9. Salin URL Web App yang berakhiran `/exec`.
# 
# ⚠️ PENTING: Pastikan URL berakhiran `/exec`, BUKAN `/dev`.
# ==================================================================================
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxxxxxxxxxxxxxxxxxxxxxx/exec
VITE_GOOGLE_SHEET_ID=11CteMG8hM_W0Eh6cvXF9sHJ-bbsu0NhnWSfR3OtAhaw


# ==================================================================================
# 4. 🤖 AI / GEMINI (GENERATOR KONTEN OTOMATIS)
# ==================================================================================
# Fungsi: Menulis artikel otomatis, membuat judul SEO, dan perbaikan teks cerdas.
# 
# 📌 CARA MENDAPATKAN GEMINI API KEY:
# 1. Buka https://aistudio.google.com/app/apikey lalu login dengan akun Google.
# 2. Klik tombol "Create API Key".
# 3. Pilih project Google Cloud (atau buat baru langsung dengan 1 klik).
# 4. Salin API Key yang diawali dengan `AIzaSy...`.
# 5. Paste ke VITE_GEMINI_API_KEY di bawah.
# 
# (Gratis kuota standar dari Google setiap hari).
# ==================================================================================
VITE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ==================================================================================
# 5. 🏷️ IDENTITAS APLIKASI & BRANDING
# ==================================================================================
# Fungsi: Mengatur nama brand, tagline, dan domain tempat website ini di-hosting.
# ==================================================================================
VITE_APP_NAME=Agenze
VITE_APP_TAGLINE=Platform Manajemen Bisnis & Portofolio
VITE_APP_DOMAIN=https://website-klien2.web.app


# ==================================================================================
# 6. 🗄️ STORAGE PREFIX (ISOLASI DATA BROWSER)
# ==================================================================================
# Fungsi: Mencegah data browser (cache/draft) tertukar jika Anda membuka 2 website di
# satu laptop/browser yang sama.
# 
# 📌 CARA MENGISI:
# Beri nama unik tanpa spasi untuk klien/tempat kedua ini.
# Contoh:
# - Website 1 : VITE_STORAGE_PREFIX=porto
# - Website 2 : VITE_STORAGE_PREFIX=klien_b
# ==================================================================================
VITE_STORAGE_PREFIX=klien_b
